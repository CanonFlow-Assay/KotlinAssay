#!/usr/bin/env python3
"""Local, pinned launcher. Files/processes are explicit tool adapters."""
from pathlib import Path
import hashlib
import json
import os
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
LOCK = json.loads((ROOT / 'toolchain.lock.json').read_text())
COMPILER_HOME = Path(LOCK['compilerHome'])
COMPILER = COMPILER_HOME / 'bin/kotlinc'
DEPS = [Path(LOCK['persistentCollectionsJar'])] + [Path(LOCK[name]['jar']) for name in ['kotlinx-serialization-core-jvm', 'kotlinx-serialization-json-jvm']]
EXPECTED = [LOCK['persistentCollectionsSha256']] + [LOCK[name]['sha256'] for name in ['kotlinx-serialization-core-jvm', 'kotlinx-serialization-json-jvm']]
sha = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()
if not COMPILER.exists() or sha(Path(LOCK['compilerArchive'])) != LOCK['compilerArchiveSha256'] or not all(sha(path) == expected for path, expected in zip(DEPS, EXPECTED)) or not all((COMPILER_HOME / path).is_file() and sha(COMPILER_HOME / path) == expected for path, expected in LOCK['compilerFilesSha256'].items()):
    raise SystemExit('Pinned toolchain missing or changed; inspect toolchain.lock.json')
BUILD = ROOT / 'build'
BUILD.mkdir(exist_ok=True)
JAR = BUILD / 'kotlin-assay.jar'
STAMP = BUILD / 'inputs.json'
SOURCES = sorted((ROOT / 'src').rglob('*.kt')) + sorted((ROOT / 'tests').rglob('*.kt'))
INPUTS = {str(p.relative_to(ROOT)): sha(p) for p in SOURCES + [ROOT / 'toolchain.lock.json']}
CP = ':'.join(str(p) for p in sorted((COMPILER_HOME / 'lib').glob('*.jar')) + DEPS)
CACHED = json.loads(STAMP.read_text()) if STAMP.exists() else {}
if not JAR.exists() or CACHED.get('inputs') != INPUTS or CACHED.get('jar') != sha(JAR):
    result = subprocess.run([str(COMPILER), *map(str, SOURCES), '-classpath', CP, '-jvm-target', '21', '-d', str(JAR)], timeout=45)
    if result.returncode:
        raise SystemExit(result.returncode)
    STAMP.write_text(json.dumps({'inputs': INPUTS, 'jar': sha(JAR)}, sort_keys=True) + '\n')
ENV = dict(os.environ, KOTLIN_ASSAY_COMPILER=str(COMPILER), KOTLIN_ASSAY_TOOLCHAIN_SHA256=sha(ROOT / 'toolchain.lock.json'))
if sys.argv[1:] == ['--self-test']:
    command = ['java', '-cp', str(JAR) + ':' + CP, 'kotlinassay.tests.PolicyTestsKt']
else:
    command = ['java', '-cp', str(JAR) + ':' + CP, 'kotlinassay.adapters.CliKt', *sys.argv[1:]]
raise SystemExit(subprocess.run(command, env=ENV).returncode)
